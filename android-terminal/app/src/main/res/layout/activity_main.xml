<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 1. FULL SCREEN CAMERA PREVIEW (No oval mask, full width & height) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. Clean Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Proper VGTC Official Logo -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/vgtc_logo"
            android:contentDescription="VGTC Official Logo"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VGTC Terminal"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:shadowColor="#B3000000"
                android:shadowRadius="8"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <!-- Live Connection Status -->
                <TextView
                    android:id="@+id/tvLiveConnection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Connecting..."
                    android:textSize="11sp"
                    android:textColor="@color/grey_status"
                    android:shadowColor="#B3000000"
                    android:shadowRadius="6"
                    android:textStyle="bold" />

                <!-- R307 Optical Fingerprint Sensor Status -->
                <TextView
                    android:id="@+id/tvR307SensorStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • 🔌 R307 Optical Sensor"
                    android:textSize="11sp"
                    android:textColor="#34D399"
                    android:shadowColor="#B3000000"
                    android:shadowRadius="6"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Manual Attendance / Master Override Button -->
        <ImageButton
            android:id="@+id/btnAttendanceOverride"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_edit"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Manual Attendance Override"
            android:tint="@color/white"
            android:layout_marginEnd="4dp" />

        <!-- Admin Lock / Settings Icon (Protected by PIN) -->
        <ImageButton
            android:id="@+id/btnAdminLock"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_lock"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Admin Settings"
            android:tint="@color/white" />
    </LinearLayout>

    <!-- 3. Minimalist Time & Date (NO seconds, NO background box) -->
    <LinearLayout
        android:id="@+id/clockSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:00 PM"
            android:textSize="38sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/white"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="10" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thursday, 24 September 2026"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:textColor="#F3F4F6"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- 4. Subtle Face Detection Indicator (HUD Pill) -->
    <TextView
        android:id="@+id/tvFaceDetectionHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Look at camera or touch fingerprint sensor"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:background="@drawable/chip_rounded"
        android:backgroundTint="#80000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="7dp"
        android:layout_marginBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 5. ATTENDANCE MARKED CONFIRMATION POPUP -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAttendanceSuccess"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="@color/white"
        android:visibility="gone"
        tools:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <ImageView
                android:id="@+id/ivSuccessCheck"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:src="@drawable/ic_check_circle"
                android:tint="@color/green_online"
                android:contentDescription="Success" />

            <TextView
                android:id="@+id/tvSuccessTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attendance Marked!"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="10dp" />

            <ImageView
                android:id="@+id/ivSuccessPhoto"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_person_placeholder"
                android:contentDescription="Employee Photo"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvSuccessName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Employee Name"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvSuccessType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Staff"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvSuccessVehicle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚛 HR55AB1234"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginTop="3dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutSuccessStatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/chip_rounded"
                android:backgroundTint="#E8F5E9"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvSuccessStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ PRESENT"
                    android:textColor="@color/green_online"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvSuccessPunchTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • 12:45 PM"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSuccessMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Method: Face Recognition"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvSuccessDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shift Duration: 8h 30m • Present (1.0 Day)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmergencyCheckout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Admin Early Checkout (Emergency)"
                android:textSize="12sp"
                android:textColor="@color/red_offline"
                app:strokeColor="@color/red_offline"
                app:cornerRadius="8dp"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvAutoDismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto-closing in 3 seconds..."
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 6. AMBIENT SCREENSAVER (Activates after 15s inactivity) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutScreensaver"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/black"
        android:visibility="gone"
        tools:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Big VGTC Official Logo in Screensaver -->
            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/vgtc_logo"
                android:contentDescription="VGTC Logo"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VGTC Logistics"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="12dp" />

            <!-- Screensaver Time (No seconds) -->
            <TextView
                android:id="@+id/tvSaverTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00 PM"
                android:textSize="64sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/white"
                android:letterSpacing="0.02"
                android:layout_marginTop="16dp" />

            <!-- Screensaver Date -->
            <TextView
                android:id="@+id/tvSaverDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thursday, 24 September 2026"
                android:textSize="16sp"
                android:fontFamily="sans-serif"
                android:textColor="#9CA3AF"
                android:layout_marginTop="4dp" />

            <!-- Pulsing hint -->
            <TextView
                android:id="@+id/tvSaverHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step in front of camera or touch screen to punch"
                android:textColor="#6B7280"
                android:textSize="13sp"
                android:layout_marginTop="32dp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
