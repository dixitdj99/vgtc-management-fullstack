<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080C14">

    <!-- 1. TOP HEADER (Matching Image 2 Right Screen) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#080C14"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Top-Left: VGTC Logo & Status under logo -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="96dp"
                    android:layout_height="38dp"
                    android:src="@drawable/vgtc_logo_white"
                    android:contentDescription="VGTC Logo"
                    android:scaleType="fitStart" />

                <!-- Status line directly under logo -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvLiveConnection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● Offline"
                        android:textSize="11.5sp"
                        android:textColor="@color/red_offline"
                        android:textStyle="bold"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/tvR307SensorStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text=" | 🔌 R307: Disconnected (Plug OTG)"
                        android:textSize="11.5sp"
                        android:textColor="#94A3B8"
                        android:textStyle="bold"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Top-Right: Language Selector Pill, Pencil Edit Button, Padlock Admin Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Language Pill: 🌐 EN ⌵ -->
                <TextView
                    android:id="@+id/btnLanguageToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/language_pill_bg"
                    android:gravity="center"
                    android:text="🌐 EN ⌵"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <!-- Circular Edit / Override Button -->
                <ImageButton
                    android:id="@+id/btnAttendanceOverride"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_edit"
                    android:background="@drawable/header_circle_btn_bg"
                    android:contentDescription="Attendance Override"
                    android:tint="@color/white"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="8dp" />

                <!-- Circular Admin Lock Button -->
                <ImageButton
                    android:id="@+id/btnAdminLock"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_lock"
                    android:background="@drawable/header_circle_btn_bg"
                    android:contentDescription="Admin PIN Settings"
                    android:tint="@color/white"
                    android:padding="9dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Hidden clockSection to preserve binding reference if referenced in code -->
        <LinearLayout
            android:id="@+id/clockSection"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">
            <TextView android:id="@+id/tvTime" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tvDate" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. ROUNDED VIEWFINDER CONTAINER (Matching Image 2 Right Screen) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewfinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Camera Preview inside rounded container -->
            <androidx.camera.view.PreviewView
                android:id="@+id/cameraPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Orange Rounded Corner Brackets Overlay -->
            <com.vgtc.terminal.FaceScanOverlayView
                android:id="@+id/scanGuides"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:importantForAccessibility="no" />

            <!-- 3. FLOATING GLASSMORPHIC STATUS CARD AT BOTTOM OF VIEWFINDER -->
            <LinearLayout
                android:id="@+id/floatingStatusCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/floating_status_card_bg"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Orange Face Reticle / Scan Icon -->
                <ImageView
                    android:id="@+id/ivDetectionIcon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_face_reticle"
                    android:contentDescription="Scanning Status Icon"
                    android:scaleType="fitCenter" />

                <!-- Detection Title: "Face detected" / "Attendance Stopped" -->
                <TextView
                    android:id="@+id/tvDetectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Looking for face or fingerprint..."
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center" />

                <!-- Subtitle / Hint / Error: "But no enrolled employees in terminal" -->
                <TextView
                    android:id="@+id/tvFaceDetectionHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Position your face inside frame or scan finger"
                    android:gravity="center"
                    android:textColor="#CCD9ED"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:accessibilityLiveRegion="polite" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- 4. ATTENDANCE MARKED SLIDE-UP CONFIRMATION CARD -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAttendanceSuccess"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="24dp"
        app:cardBackgroundColor="@color/white"
        android:visibility="gone"
        tools:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <ImageView
                android:id="@+id/ivSuccessCheck"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_check_circle"
                android:tint="@color/green_online"
                android:contentDescription="Success" />

            <TextView
                android:id="@+id/tvSuccessTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attendance Marked!"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="6dp" />

            <ImageView
                android:id="@+id/ivSuccessPhoto"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_person_placeholder"
                android:contentDescription="Employee Photo"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvSuccessName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Employee Name"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvSuccessType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Staff"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvSuccessVehicle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚛 HR55AB1234"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginTop="3dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutSuccessStatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/chip_rounded"
                android:backgroundTint="#E8F5E9"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/tvSuccessStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ PRESENT"
                    android:textColor="@color/green_online"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvSuccessPunchTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • 12:45 PM"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSuccessMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Method: Face Recognition"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvSuccessDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shift Duration: 8h 30m • Present (1.0 Day)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmergencyCheckout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Admin Early Checkout (Emergency)"
                android:textSize="12sp"
                android:textColor="@color/red_offline"
                app:strokeColor="@color/red_offline"
                app:cornerRadius="8dp"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvAutoDismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto-closing in 3 seconds..."
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                android:layout_marginTop="10dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 4b. UNREGISTERED FACE ALERT CARD (Red Cross, 5-Second Animated Progress Bar) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardUnregisteredFace"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="24dp"
        app:cardBackgroundColor="@color/white"
        android:visibility="gone"
        tools:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/circle_red_badge">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_close"
                    android:tint="@color/white"
                    android:contentDescription="Not Enrolled" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvUnregisteredTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Face Not Enrolled"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#DC2626"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvUnregisteredSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You are not registered in the staff profile"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvUnregisteredDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your face biometrics are not registered on this terminal. Please contact office administration."
                android:textSize="12.5sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginTop="6dp" />

            <!-- Animated countdown progress bar -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressDismissUnregistered"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="16dp"
                app:indicatorColor="#DC2626"
                app:trackColor="#20DC2626"
                app:trackCornerRadius="2dp"
                android:max="1000"
                android:progress="1000" />

            <TextView
                android:id="@+id/tvUnregisteredTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Closing in 5 seconds..."
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 5. SCREENSAVER / STANDBY SCREEN (Matching Image 2 Left Screen) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutScreensaver"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#071324"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fullscreen cinematic truck on road at dusk -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/terminal_truck_road"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <!-- Subtle dark tint for maximum contrast -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#2E040E1E" />

        <!-- Top & Center Branding & Time Display -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.28"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- VGTC White Logo -->
            <ImageView
                android:layout_width="210dp"
                android:layout_height="86dp"
                android:src="@drawable/vgtc_logo_white"
                android:contentDescription="VGTC Official Logo"
                android:scaleType="fitCenter" />

            <!-- "TRANSPORT MANAGEMENT" in small spaced uppercase letters -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="TRANSPORT MANAGEMENT"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <!-- Clock: Digits in bold White + 'pm'/'am' in vibrant Orange -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal"
                android:baselineAligned="true"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvSaverTimeDigits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:01"
                    android:textColor="#FFFFFF"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvSaverTimeAmPm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="pm"
                    android:textColor="#FF8900"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Hidden tvSaverTime to maintain binding reference if needed -->
            <TextView
                android:id="@+id/tvSaverTime"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Date: e.g. Saturday, 03 October 2026 -->
            <TextView
                android:id="@+id/tvSaverDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Saturday, 03 October 2026"
                android:textColor="#CCD9ED"
                android:textSize="16sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- Bottom Pill: "Touch screen to start" matching Image 2 Left Screen -->
        <LinearLayout
            android:id="@+id/layoutSaverButton"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_marginHorizontal="28dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/standby_button_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Left: Orange badge with touch hand icon -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_orange_badge">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_touch_start"
                    android:contentDescription="Touch"
                    android:tint="@color/white" />
            </FrameLayout>

            <!-- Center: "Touch screen to start" -->
            <TextView
                android:id="@+id/tvSaverHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="Touch screen to start"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <!-- Right: chevron '>' -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="›"
                android:textColor="#A0AEC0"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
