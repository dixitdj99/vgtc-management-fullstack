<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 1. FULL SCREEN CAMERA PREVIEW (No oval mask, full width & height) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. Clean 2-Row Top Header Overlay -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#C0000000"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 1: Logo & Title (Left), Action Controls (Right) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Left: Logo + App Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="56dp"
                    android:layout_height="32dp"
                    android:src="@drawable/vgtc_logo_white"
                    android:contentDescription="VGTC Official Logo"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="VGTC Terminal"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Right: Language Toggle, Pencil Override, Admin Lock -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLanguageToggle"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="🌐 EN"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    app:strokeColor="#64748B"
                    app:strokeWidth="1dp"
                    app:cornerRadius="16dp"
                    android:paddingHorizontal="8dp"
                    android:layout_marginEnd="6dp" />

                <ImageButton
                    android:id="@+id/btnAttendanceOverride"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_edit"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Override"
                    android:tint="@color/white"
                    android:layout_marginEnd="2dp" />

                <ImageButton
                    android:id="@+id/btnAdminLock"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_lock"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Admin Lock"
                    android:tint="@color/white" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Row 2: Status Pill (Left), Live Clock & Date (Right) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <!-- Status Indicators -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvLiveConnection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Online"
                    android:textSize="12sp"
                    android:textColor="@color/green_online"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/tvR307SensorStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text=" • 🔌 R307 Optical Sensor"
                    android:textSize="12sp"
                    android:textColor="#34D399"
                    android:textStyle="bold"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Live Clock & Date -->
            <LinearLayout
                android:id="@+id/clockSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10:31 PM"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Sat, 26 Sep"
                    android:textSize="12sp"
                    android:textColor="#9CA3AF"
                    android:singleLine="true" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <!-- 4. Subtle Face Detection Indicator (HUD Pill) -->
    <TextView
        android:id="@+id/tvFaceDetectionHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Look at camera or touch fingerprint sensor"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:background="@drawable/chip_rounded"
        android:backgroundTint="#80000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="7dp"
        android:layout_marginBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 5. ATTENDANCE MARKED SLIDE-UP BOTTOM SHEET -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAttendanceSuccess"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="20dp"
        app:cardBackgroundColor="@color/white"
        android:visibility="gone"
        tools:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <ImageView
                android:id="@+id/ivSuccessCheck"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_check_circle"
                android:tint="@color/green_online"
                android:contentDescription="Success" />

            <TextView
                android:id="@+id/tvSuccessTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attendance Marked!"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp" />

            <ImageView
                android:id="@+id/ivSuccessPhoto"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_person_placeholder"
                android:contentDescription="Employee Photo"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvSuccessName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Employee Name"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvSuccessType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Staff"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvSuccessVehicle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚛 HR55AB1234"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginTop="3dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutSuccessStatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/chip_rounded"
                android:backgroundTint="#E8F5E9"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvSuccessStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ PRESENT"
                    android:textColor="@color/green_online"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvSuccessPunchTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • 12:45 PM"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSuccessMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Method: Face Recognition"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvSuccessDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shift Duration: 8h 30m • Present (1.0 Day)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmergencyCheckout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Admin Early Checkout (Emergency)"
                android:textSize="12sp"
                android:textColor="@color/red_offline"
                app:strokeColor="@color/red_offline"
                app:cornerRadius="8dp"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvAutoDismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto-closing in 3 seconds..."
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 6. AMBIENT ALWAYS-ON DISPLAY SCREENSAVER (Activates after 15s inactivity) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutScreensaver"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/black"
        android:visibility="gone"
        tools:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Big Premium White VGTC Official Logo in Screensaver -->
            <ImageView
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:src="@drawable/vgtc_logo_white"
                android:contentDescription="VGTC Logo"
                android:scaleType="fitCenter" />

            <!-- Screensaver Time (No seconds) -->
            <TextView
                android:id="@+id/tvSaverTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00 PM"
                android:textSize="68sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/white"
                android:letterSpacing="0.02"
                android:layout_marginTop="24dp" />

            <!-- Screensaver Date -->
            <TextView
                android:id="@+id/tvSaverDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thursday, 24 September 2026"
                android:textSize="16sp"
                android:fontFamily="sans-serif"
                android:textColor="#9CA3AF"
                android:layout_marginTop="6dp" />

            <!-- Touch screen hint -->
            <TextView
                android:id="@+id/tvSaverHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Touch screen to start"
                android:textColor="#9CA3AF"
                android:textSize="14sp"
                android:layout_marginTop="36dp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
