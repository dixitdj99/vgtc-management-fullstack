<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 1. Live Camera Preview (Direct when app opens) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. Face Guide Oval Overlay -->
    <com.vgtc.terminal.FaceScanOverlayView
        android:id="@+id/faceOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3. Top Header Bar (Glassmorphic dark card) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="#B3000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_vgtc_logo"
            android:contentDescription="VGTC Logo"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VGTC Terminal"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <!-- Live Connection Status -->
            <TextView
                android:id="@+id/tvLiveConnection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Connecting..."
                android:textSize="12sp"
                android:textColor="@color/grey_status"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Enroll Button -->
        <ImageButton
            android:id="@+id/btnEnroll"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_person_add"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Enroll Face or Fingerprint"
            android:tint="@color/white"
            android:layout_marginEnd="6dp" />

        <!-- Settings Button -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:tint="@color/white"
            android:layout_marginEnd="6dp" />

        <!-- Exit App Button -->
        <ImageButton
            android:id="@+id/btnExit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_exit"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Exit App"
            android:tint="#EF4444" />
    </LinearLayout>

    <!-- 4. Floating Live Digital Clock & Date -->
    <LinearLayout
        android:id="@+id/clockCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/chip_rounded"
        android:backgroundTint="#80000000"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:00:00 PM"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/white"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thursday, 24 September 2026"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:textColor="#D1D5DB" />
    </LinearLayout>

    <!-- 5. Face Scan Status Hint -->
    <TextView
        android:id="@+id/tvFaceStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Align face within the oval guide"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/chip_rounded"
        android:backgroundTint="#99000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 6. Bottom Controls Bar -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp"
        android:paddingTop="12dp"
        android:background="#CC000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fingerprint Punch Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFingerprintPunch"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:text="Fingerprint Punch"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            app:icon="@drawable/ic_fingerprint"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="28dp"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/primary"
            android:textColor="@color/white"
            android:elevation="4dp" />

        <!-- Manual Select Employee Option -->
        <TextView
            android:id="@+id/btnSelectEmployee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Employee from List"
            android:textColor="#60A5FA"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <!-- 7. ATTENDANCE MARKED CONFIRMATION POPUP (Overlay Modal) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAttendanceSuccess"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/white"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- Checkmark circle -->
            <ImageView
                android:id="@+id/ivSuccessCheck"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_check_circle"
                android:tint="@color/green_online"
                android:contentDescription="Success" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attendance Marked!"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="10dp" />

            <!-- Employee Photo / Avatar -->
            <ImageView
                android:id="@+id/ivSuccessPhoto"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_person_placeholder"
                android:contentDescription="Employee Photo"
                android:layout_marginTop="14dp" />

            <!-- Employee Name -->
            <TextView
                android:id="@+id/tvSuccessName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Employee Name"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp" />

            <!-- Employee Type -->
            <TextView
                android:id="@+id/tvSuccessType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Staff"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />

            <!-- Status & Time Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/chip_rounded"
                android:backgroundTint="#E8F5E9"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvSuccessStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ PRESENT"
                    android:textColor="@color/green_online"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvSuccessPunchTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • 12:45 PM"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Auto-dismiss hint -->
            <TextView
                android:id="@+id/tvAutoDismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto-closing in 3 seconds..."
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                android:layout_marginTop="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSuccessDismiss"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Done"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="10dp"
                app:backgroundTint="@color/primary"
                android:textColor="@color/white"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
