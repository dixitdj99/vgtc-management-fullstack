<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_person_placeholder"
                android:contentDescription="Photo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Employee Name"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Staff"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

                <!-- Badges for enrolled status -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/badgeFace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Face ✓"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/green_online"
                        android:background="@drawable/chip_rounded"
                        android:backgroundTint="#E8F5E9"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/badgeFingerprint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fingerprint ✓"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/green_online"
                        android:background="@drawable/chip_rounded"
                        android:backgroundTint="#E8F5E9"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Edit Button -->
            <ImageButton
                android:id="@+id/btnEdit"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_edit"
                android:tint="@color/primary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit" />

            <!-- Delete Button -->
            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_delete"
                android:tint="#EF4444"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginVertical="10dp" />

        <!-- Action buttons: Re-enroll Face & Fingerprint -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnrollFace"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Face Scan"
                android:textSize="12sp"
                app:icon="@drawable/ic_face_scan"
                app:iconSize="18dp"
                app:cornerRadius="8dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnrollFingerprint"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Fingerprint"
                android:textSize="12sp"
                app:icon="@drawable/ic_fingerprint"
                app:iconSize="18dp"
                app:cornerRadius="8dp"
                app:backgroundTint="@color/primary"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
