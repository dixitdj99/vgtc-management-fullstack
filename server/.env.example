# ══════════════════════════════════════════════════════════════════
# VGTC Management Server — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it is in .gitignore).
# ══════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────
# ENVIRONMENT TIER (Required)
# ──────────────────────────────────────────────────────────────────
# Controls which Firestore collections this server reads/writes to.
#
#  local      → Writes to "dev_*" collections on your machine
#  beta       → Writes to "beta_*" collections on a staging deploy
#  production → Writes to bare collections on the live deploy
#
# On Firebase App Hosting: set under `env:` in apphosting.yaml
# Locally: always keep as 'local'  ← DO NOT set to 'production' locally!
APP_ENV=local

# Set to 'true' to fully block write operations when not in production.
# Useful for read-only inspection of data in another environment.
BLOCK_PROD_WRITES=false

# ──────────────────────────────────────────────────────────────────
# AUTHENTICATION
# ──────────────────────────────────────────────────────────────────
JWT_SECRET=vgtc-secret-2026

# ──────────────────────────────────────────────────────────────────
# SMTP — OTP Email Sending
# ──────────────────────────────────────────────────────────────────
# For Gmail: create an "App Password" in Google Account Security settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# WhatsApp AI replies — user-initiated text only. Leave key empty to disable.
# Obtain key in Google AI Studio; never commit a real value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
WHATSAPP_AI_ENABLED=true

# Meta App Dashboard > App settings > Basic > App secret.
# Required for signed POST /api/whatsapp/webhook requests.
META_APP_ID=
META_APP_SECRET=

# Meta WhatsApp Cloud API. Fill these in server/.env for local use, or enter
# sending credentials and verify token in WhatsApp Control Module.
# Use a long-lived production token; never commit a real value.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
# Choose a random string; enter same value in Meta webhook configuration.
META_WEBHOOK_VERIFY_TOKEN=

# ──────────────────────────────────────────────────────────────────
# FIREBASE (Optional — falls back to local JSON if not provided)
# ──────────────────────────────────────────────────────────────────
# Local: place serviceAccountKey.json in server/ directory
# Cloud: paste the entire JSON content as a single-line string below
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
# Production terminal credential. Generate a long random value; never use the
# development fallback in production. Android stores this in terminal settings.
TERMINAL_KEY=
# Private Cloud Storage bucket used for enrollment images. Do not make objects public.
FIREBASE_STORAGE_BUCKET=
